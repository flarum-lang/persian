{
	"name": "flarum-lang/persian",
	"description": "Persian Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/persian",
	"license": "MIT",
	"authors": [
		{
			"name": "claudiush",
			"homepage": "https://github.com/claudiush",
			"role": "Maintainer"
		}
	],
	"support": {
		"issues": "https://github.com/flarum-lang/persian/issues",
		"forum": "https://discuss.flarum.org/d/35866",
		"source": "https://github.com/flarum-lang/persian"
	},
	"require": {
		"flarum/core": "^1.0"
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.x-dev"
		},
		"flarum-extension": {
			"title": "Persian",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
			}
		},
		"flarum-locale": {
			"code": "fa",
			"title": "فارسی",
			"direction": "rtl"
		}
	}
}
